# JanMaang web.
#
# EVERY NEXT_PUBLIC_ VALUE IS PUBLIC. It is compiled into the browser bundle and
# readable by anyone who opens devtools. Never put a server key here — the LLM
# key, the database URL and the Firebase service account belong to services/api.

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ENVIRONMENT=development

# Firebase web config. Public by design — these identify the project, they do
# not authorise anything. Access is controlled by Security Rules and by the API.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Map tiles. Restrict this key by HTTP referrer in the provider console —
# a browser key cannot be kept secret, only scoped.
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAPS_API_KEY=

# Server-only (no NEXT_PUBLIC_ prefix): never reaches the browser.
# Signs the session cookie. Production builds refuse to run if it is unset,
# under 32 characters, or a placeholder like the one below — a published
# value would make every session forgeable.
# Generate with: openssl rand -hex 32
AUTH_SECRET=dev-only-not-a-real-secret-change-me

# Demo personas (lib/auth/directory.ts) sign in with a password printed in
# the README, including a Super Admin. Always on in `next dev`; OFF in every
# production build unless set to exactly `enabled`. Set it on a staging
# review deployment only — never on anything that holds real data.
# DEMO_AUTH=enabled

# ---------------------------------------------------------------------------
# AI Project Council (src/lib/council/)
#
# ARCHITECTURAL DEBT, recorded in docs/architecture/decisions/0005. Invariant 3
# says the API is the only caller of an AI service; the council calls Groq from
# Next route handlers instead. It moves to services/ai — see that ADR.
#
# Server-only, no NEXT_PUBLIC_ prefix. This key must never reach the browser.
# ---------------------------------------------------------------------------

# Powers every council agent's spoken turn and the final verdict. Without it,
# /student/council/session answers 503 and says so. Free key, no card:
# https://console.groq.com/keys
GROQ_API_KEY=

# Optional — the model that writes the verdict. Unset uses openai/gpt-oss-120b,
# which supports strict JSON-schema output and so scores most reliably. Groq
# retires model ids without notice and a retired id 404s on every call, so
# check https://api.groq.com/openai/v1/models before pinning one.
# GROQ_MODEL=openai/gpt-oss-120b

# Optional — the model for spoken debate turns only. These are ~18 of the ~19
# calls in a session and the easiest work, so they default to a smaller model.
# Groq meters rate limits per model, which also keeps debate traffic off the
# bucket the verdict depends on.
# GROQ_DEBATE_MODEL=openai/gpt-oss-20b

# Optional — how long a session runs. Read by both the client and the server.
#   standard (default)  diagnosis + challenge + refinement = 3 turns per agent
#   quick               drops the challenge round = 2 turns per agent
#   deep                two challenge rounds = 4 turns per agent
# A six-seat panel on `standard` is 18 turns.
# NEXT_PUBLIC_COUNCIL_PROFILE=standard
