  },
  "devDependencies": {
    "@janmaang/config": "workspace:*",
    "@playwright/test": "^1.48.2",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.14.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.1.14",
