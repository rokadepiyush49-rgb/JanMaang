{
  "name": "@janmaang/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared ESLint, TypeScript and Prettier presets. Tailwind v4 is CSS-first \u2014 its theme lives in @janmaang/tokens, not here.",
  "type": "module",
  "exports": {
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/nextjs.json": "./tsconfig/nextjs.json",
    "./eslint": "./eslint/index.mjs",
    "./prettier": "./prettier/index.mjs"
  },
  "scripts": {
    "lint": "echo \"@janmaang/config: presets only\" && exit 0",
    "format": "echo \"@janmaang/config: presets only\" && exit 0",
    "typecheck": "echo \"@janmaang/config: presets only\" && exit 0",
    "test": "echo \"@janmaang/config: presets only\" && exit 0"
  },
  "dependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^10.13.0",
    "typescript-eslint": "^8.14.0"
  }
}
