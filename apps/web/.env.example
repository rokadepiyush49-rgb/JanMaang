# JanMaang web.
#
# EVERY NEXT_PUBLIC_ VALUE IS PUBLIC. It is compiled into the browser bundle and
# readable by anyone who opens devtools. Never put a server key here — the LLM
# key, the database URL and the Firebase service account belong to services/api.

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ENVIRONMENT=development

# Firebase web config. Public by design — these identify the project, they do
# not authorise anything. Access is controlled by Security Rules and by the API.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Map tiles. Restrict this key by HTTP referrer in the provider console —
# a browser key cannot be kept secret, only scoped.
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAPS_API_KEY=

# Server-only (no NEXT_PUBLIC_ prefix): never reaches the browser.
# Signs the session cookie. Generate with: openssl rand -hex 32
AUTH_SECRET=dev-only-not-a-real-secret-change-me
